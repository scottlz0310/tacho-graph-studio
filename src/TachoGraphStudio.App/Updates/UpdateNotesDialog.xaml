<ContentDialog
    x:Class="TachoGraphStudio.App.Updates.UpdateNotesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="閉じる"
    Title="新しくなりました">
    <Grid
        MinWidth="480"
        MaxWidth="720"
        RowDefinitions="Auto,Auto"
        RowSpacing="16">
        <ScrollViewer
            Grid.Row="0"
            MaxHeight="520"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <RichTextBlock
                x:Name="NotesTextBlock"
                TextWrapping="Wrap" />
        </ScrollViewer>
        <HyperlinkButton
            x:Name="ReleaseLinkButton"
            Grid.Row="1"
            HorizontalAlignment="Left"
            Content="リリースページを開く" />
    </Grid>
</ContentDialog>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>TachoGraphStudio.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- MSIX packaged アプリは AnyCPU 不可。Platform 未指定（ソリューション経由）でも RID が解決されるよう既定を x64 にする -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- 既定の Auto は scale/DXFeatureLevel 修飾子を検出するとバンドル化し、
         生成される ForBundle\AppxManifest.xml が MakeAppx の検証に落ちる（#76）。
         配布は .appinstaller によるアーキテクチャ別 MSIX 単体のため、バンドルは不要。 -->
    <AppxBundle>Never</AppxBundle>
    <!-- NFR-02: .NET / Windows App SDK ランタイムを MSIX に同梱し、外部ランタイム非依存にする -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- splash を WinUI ランタイム初期化より前に出すため、XAML 生成の Main を抑止して
         Program.cs の Main を使う（#81） -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="WinUI.TableView" Version="1.4.1" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TachoGraphStudio.Core\TachoGraphStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MSIX には appxrecipe 経由でプロジェクト配下から直接取り込まれるが、
         AppWindow.SetIcon は実行ディレクトリを基準に解決するため出力にも配置する（#79） -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- 更新後の変更点ダイアログが読むリリースノート（#100） -->
    <Content
      Include="..\..\CHANGELOG.md"
      Link="CHANGELOG.md"
      CopyToOutputDirectory="PreserveNewest" />
    <!-- App Installer のカスタム UX（#92）。パッケージルート直下の
         MSIX.AppInstaller.Data フォルダに置く必要がある -->
    <Content Include="MSIX.AppInstaller.Data\MSIXAppInstallerData.xml" />
  </ItemGroup>

</Project>

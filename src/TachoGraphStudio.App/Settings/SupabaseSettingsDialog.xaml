<ContentDialog
    x:Class="TachoGraphStudio.App.Settings.SupabaseSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Supabase 接続設定"
    CloseButtonText="キャンセル"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="保存">
    <StackPanel MinWidth="360" Spacing="12">
        <TextBlock
            Text="名簿データを取得する Supabase プロジェクトの URL・anon キーを入力し、業者一覧を読み込んでください。"
            TextWrapping="Wrap" />
        <TextBox
            x:Name="ProjectUrlTextBox"
            Header="プロジェクト URL"
            PlaceholderText="https://xxxxx.supabase.co"
            TextChanged="OnProjectUrlTextChanged" />
        <PasswordBox
            x:Name="AnonKeyPasswordBox"
            Header="anon キー"
            PasswordChanged="OnAnonKeyPasswordChanged" />
        <Button
            x:Name="LoadVendorsButton"
            Click="OnLoadVendorsButtonClick"
            Content="業者一覧を読み込む"
            HorizontalAlignment="Left" />
        <ComboBox
            x:Name="VendorComboBox"
            Header="業者"
            DisplayMemberPath="DisplayLabel"
            PlaceholderText="業者を選択してください"
            IsEnabled="False" />
        <PasswordBox
            x:Name="PasswordBox"
            Header="パスワード" />
        <TextBlock
            x:Name="ErrorTextBlock"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>

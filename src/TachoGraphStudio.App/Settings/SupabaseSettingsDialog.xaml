<winuiex:WindowEx
    x:Class="TachoGraphStudio.App.Settings.SupabaseSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    Title="設定"
    Width="680"
    Height="720"
    MinWidth="560"
    MinHeight="520"
    IsMaximizable="True"
    IsMinimizable="False"
    IsResizable="True">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Loaded="OnLoaded"
        RowDefinitions="*,Auto,Auto">
        <TabView
            x:Name="SettingsTabView"
            Grid.Row="0"
            Margin="20,20,20,0"
            IsAddTabButtonVisible="False"
            TabWidthMode="Equal">
        <TabViewItem Header="画像処理" IsClosable="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="4,12,4,4" Spacing="12">
                    <TextBlock
                        Text="スキャナやチャート紙に合わせて円盤の検出・切り出しを調整します。変更後はシートを再処理してください。"
                        TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,160" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="前景判定しきい値" />
                            <Slider
                                Minimum="1"
                                Maximum="255"
                                StepFrequency="1"
                                Value="{Binding Value, ElementName=ThresholdNumberBox, Mode=TwoWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="小さいほど淡い印字を前景として検出します。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <NumberBox
                            x:Name="ThresholdNumberBox"
                            Grid.Column="1"
                            Header="値"
                            Minimum="1"
                            Maximum="255"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            ValidationMode="InvalidInputOverwritten" />
                    </Grid>
                    <NumberBox
                        x:Name="PaddingNumberBox"
                        MinWidth="200"
                        HorizontalAlignment="Left"
                        Header="切り出し余白 (px)"
                        Description="入力 DPI が不明な JPEG で、検出領域の周囲に付加する余白です。"
                        Minimum="0"
                        Maximum="2147483647"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        ValidationMode="InvalidInputOverwritten" />
                    <NumberBox
                        x:Name="EllipsePaddingNumberBox"
                        MinWidth="200"
                        HorizontalAlignment="Left"
                        Header="アルファ円マージン (px)"
                        Description="正で円盤の縁を残し、負で内側へ絞ります。"
                        Minimum="-2147483648"
                        Maximum="2147483647"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        ValidationMode="InvalidInputOverwritten" />
                    <Button
                        HorizontalAlignment="Left"
                        Click="OnRestoreImageProcessingDefaultsButtonClick"
                        Content="既定値に戻す" />
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>
        <TabViewItem Header="Supabase 接続" IsClosable="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="4,12,4,4" Spacing="12">
                    <TextBlock
                        Text="名簿データを取得する Supabase プロジェクトの URL・anon キーを入力し、業者一覧を読み込んでください。"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="ProjectUrlTextBox"
                        Header="プロジェクト URL"
                        PlaceholderText="https://xxxxx.supabase.co"
                        TextChanged="OnProjectUrlTextChanged" />
                    <PasswordBox
                        x:Name="AnonKeyPasswordBox"
                        Header="anon キー"
                        PasswordChanged="OnAnonKeyPasswordChanged" />
                    <Button
                        x:Name="LoadVendorsButton"
                        HorizontalAlignment="Left"
                        Click="OnLoadVendorsButtonClick"
                        Content="業者一覧を読み込む" />
                    <ComboBox
                        x:Name="VendorComboBox"
                        Header="業者"
                        DisplayMemberPath="DisplayLabel"
                        IsEnabled="False"
                        PlaceholderText="業者を選択してください" />
                    <PasswordBox
                        x:Name="PasswordBox"
                        Header="パスワード" />
                </StackPanel>
            </ScrollViewer>
        </TabViewItem>
        </TabView>
        <TextBlock
            x:Name="ErrorTextBlock"
            Grid.Row="1"
            Margin="28,12,28,0"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <Border
            Grid.Row="2"
            Margin="0,16,0,0"
            Padding="20"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    Click="OnCancelButtonClick"
                    Content="キャンセル" />
                <Button
                    x:Name="SaveButton"
                    Click="OnSaveButtonClick"
                    Content="保存"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</winuiex:WindowEx>
